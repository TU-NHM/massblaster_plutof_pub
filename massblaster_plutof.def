# A base Ubuntu 22 Singularity container with support for PlutoF massBLASTer tool

BootStrap: docker
From: ubuntu:22.04

%post
    set -e

    apt-get update -y

    # wget
    apt-get install -y wget

    # libgomp1
    apt-get install -y libgomp1

    # Installing BLAST
    wget https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.17.0/ncbi-blast-2.17.0+-x64-linux.tar.gz
    tar -xzvf ncbi-blast-2.17.0+-x64-linux.tar.gz

    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export LC_ALL=C
    export PATH=$PATH:/ncbi-blast-2.17.0+/bin

%runscript
    exec "$@"

%labels
    Author kessya

%files
    run_massblaster.sh
